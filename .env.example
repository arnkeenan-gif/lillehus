# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (bakery shop) ---
# Dashboard → Developers → API keys. Use test keys (sk_test_/pk_test_) until launch.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → endpoint https://<site>/api/stripe/webhook
# Events: checkout.session.completed and checkout.session.async_payment_succeeded (MobilePay can complete asynchronously)
STRIPE_WEBHOOK_SECRET=
# Enable MobilePay + card in Dashboard → Settings → Payment methods.

# --- Resend (all email: orders, pizza bookings, cake requests, contact) ---
# resend.com → API Keys. Verify the sending domain before launch;
# until then only onboarding@resend.dev works and only delivers to the account owner.
RESEND_API_KEY=
EMAIL_FROM="Det lille hus på landet <bestilling@detlillehuspaalandet.net>"
# Where bookings, orders and contact messages are sent (Kristine).
EMAIL_TO=kristine.k.h@gmail.com
# Resend Audience ID for the newsletter signup (optional).
RESEND_AUDIENCE_ID=

# --- Sanity (Studio at /studio, content for every page) ---
# sanity.io/manage → the project → the id in the URL or under Settings. Public; also set in Vercel.
# Leave empty and the site reads the JSON files in content/ instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. Only if the dataset is private (Manage → API → Tokens, Viewer). Server only.
SANITY_API_READ_TOKEN=
# Seed only (npm run seed:sanity). Manage → API → Tokens, Editor. Never put this in Vercel.
SANITY_API_WRITE_TOKEN=
# A long random string. The same value goes into the webhook in Manage → API → Webhooks
# (URL https://<site>/api/revalidate) so the site refreshes the moment Kristine publishes.
SANITY_REVALIDATE_SECRET=
